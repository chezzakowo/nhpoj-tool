{
  "manifest_version": 3,
  "name": "NHP::OJ Tools (Beta)",
  "version": "1.0",
  "description": "Bot tự động Daily Sign-in cho nhpoj.net. Một công cụ bởi Chez_",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://nhpoj.net/*"
  ]
}
